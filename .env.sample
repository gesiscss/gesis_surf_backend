# Database
DB_NAME=dbname
DB_USER=rootuser
DB_PASSWORD=              # REQUIRED: set a strong password

# Django
DJANGO_SECRET_KEY=        # REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=0            # 0 for production, 1 for development

# CORS
# Extra allowed origins, comma-separated. The default set (localhost +
# the published extension ID) is always allowed; this appends to it.
# Example: CORS_ALLOWED_ORIGINS=chrome-extension://newextensionid
CORS_ALLOWED_ORIGINS=

# SSL / Domain
ACME_DEFAULT_EMAIL=email@example.com
DOMAIN=example.com

# App
MAINTENANCE_MODE=False
