# Copy to .env on the server and fill in the REQUIRED values.
# Used with: docker compose -f docker-compose.mobile-staging.yaml up -d --build
# Keep comments on their own lines: Compose treats "KEY=  # text" as the value.

# Database (separate Postgres container and volume from the other staging)
DB_NAME=mobile_staging
DB_USER=mobile_staging
# REQUIRED: set a strong password
DB_PASSWORD=

# REQUIRED: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# REQUIRED: public hostname IT assigns, plus the server's own name for direct tests
DJANGO_ALLOWED_HOSTS=mobile-staging.example.org,staging-surfcollect.gesis.intra,localhost

# Extra allowed CORS origins, comma-separated (optional)
CORS_ALLOWED_ORIGINS=

# Host port for the HTTP proxy. Pick a free one: check with `ss -tlnp`.
MOBILE_HTTP_PORT=18473
# 0.0.0.0 if the upstream proxy is on another machine, 127.0.0.1 if it is on this host
MOBILE_HTTP_BIND=0.0.0.0
